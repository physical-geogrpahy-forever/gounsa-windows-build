+#include "stdafx.h"
+#include "gounsa_cohort_output.h"
+#include "guess.h"
+
+#include <fstream>
+#include <iomanip>
+
+namespace {
+std::ofstream out;
+bool header=false;
+}
+
+namespace gounsa_cohort_output {
+
+void annual(const Gridcell& gridcell) {
+	if(!out.is_open()) out.open("gounsa_cohorts.out",std::ios::out);
+	if(!header) {
+		out << "Lon Lat Year Stand Patch PFT DensIndiv Height CrownArea LeafC FineRootC SapC HeartC DebtC Age\n";
+		header=true;
+	}
+	for(int s=0;s<gridcell.nbr_stands();++s) {
+		const Stand& stand=gridcell[s];
+		for(int p=0;p<stand.npatch();++p) {
+			const Patch& patch=stand[p];
+			for(unsigned int i=0;i<patch.vegetation.size();++i) {
+				const Individual& indiv=patch.vegetation[i];
+				out << std::setprecision(10) << gridcell.get_lon() << ' ' << gridcell.get_lat() << ' '
+				    << date.get_calendar_year() << ' ' << s << ' ' << p << ' ' << indiv.pft.name << ' '
+				    << indiv.densindiv << ' ' << indiv.height << ' ' << indiv.crownarea << ' '
+				    << indiv.cmass_leaf << ' ' << indiv.cmass_root << ' ' << indiv.cmass_sap << ' '
+				    << indiv.cmass_heart << ' ' << indiv.cmass_debt << ' ' << indiv.age << '\n';
+			}
+		}
+	}
+}
+
+}
