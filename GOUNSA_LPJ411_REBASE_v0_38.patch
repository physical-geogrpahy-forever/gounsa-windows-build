+#ifndef GOUNSA_DIRECT_INITIAL_STATE_H
+#define GOUNSA_DIRECT_INITIAL_STATE_H
+
+#include <string>
+
+class Gridcell;
+
+namespace gounsa_direct_initial_state {
+
+// Load a CSV containing observed/projected 2022 full-state values. The CSV is
+// intentionally external to the LPJ core so the original process equations and
+// parameterisation remain unchanged. Rows are keyed by lon/lat and PFT.
+void load_csv(const std::string& filename);
+
+// Apply a matching state, if present, immediately after the input module has
+// populated the gridcell and before the transient simulation begins.
+void apply_if_available(Gridcell& gridcell);
+
+}
+
+#endif
--- /dev/null
+++ b/guess_4.1/framework/gounsa_direct_initial_state.cpp
@@ -0,0 +1,259 @@
+#include "stdafx.h"
+#include "gounsa_direct_initial_state.h"
+#include "guess.h"
+#include "vegetation.h"
+#include "pft.h"
+
+#include <fstream>
+#include <sstream>
+#include <map>
+#include <vector>
+#include <cmath>
+#include <cstdlib>
+
+namespace {
+
+struct StateRow {
+	double lon, lat;
+	std::string pft;
+	double densindiv, height, crownarea, cmass_leaf, cmass_root, cmass_sap, cmass_heart;
+	double cmass_debt, age;
+};
+
+std::vector<StateRow> rows;
+
+std::vector<std::string> split_csv(const std::string& s) {
+	std::vector<std::string> out;
+	std::string cur;
+	bool q=false;
+	for (size_t i=0;i<s.size();++i) {
+		char c=s[i];
+		if (c=='\"') q=!q;
+		else if (c==',' && !q) { out.push_back(cur); cur.clear(); }
+		else cur+=c;
+	}
+	out.push_back(cur);
+	return out;
+}
+
+double num(const std::string& x) { return std::atof(x.c_str()); }
+
+bool near(double a,double b) { return std::fabs(a-b)<5e-5; }
+
+}
+
+namespace gounsa_direct_initial_state {
+
+void load_csv(const std::string& filename) {
+	rows.clear();
+	std::ifstream f(filename.c_str());
+	if (!f) fail("Could not open Gounsa direct-state CSV %s",filename.c_str());
+	std::string line;
+	if (!std::getline(f,line)) fail("Empty Gounsa direct-state CSV");
+	std::vector<std::string> h=split_csv(line);
+	std::map<std::string,int> c;
+	for(size_t i=0;i<h.size();++i)c[h[i]]=(int)i;
+	const char* req[]={"lon","lat","pft","densindiv","height","crownarea","cmass_leaf","cmass_root","cmass_sap","cmass_heart","cmass_debt","age"};
+	for(size_t k=0;k<12;++k) if(!c.count(req[k])) fail("Gounsa direct-state CSV missing column %s",req[k]);
+	while(std::getline(f,line)) {
+		if(line.empty())continue;
+		std::vector<std::string> v=split_csv(line);
+		StateRow r;
+		r.lon=num(v[c["lon"]]); r.lat=num(v[c["lat"]]); r.pft=v[c["pft"]];
+		r.densindiv=num(v[c["densindiv"]]); r.height=num(v[c["height"]]); r.crownarea=num(v[c["crownarea"]]);
+		r.cmass_leaf=num(v[c["cmass_leaf"]]); r.cmass_root=num(v[c["cmass_root"]]); r.cmass_sap=num(v[c["cmass_sap"]]); r.cmass_heart=num(v[c["cmass_heart"]]);
+		r.cmass_debt=num(v[c["cmass_debt"]]); r.age=num(v[c["age"]]);
+		rows.push_back(r);
+	}
+}
+
+void apply_if_available(Gridcell& gridcell) {
+	for(size_t ir=0;ir<rows.size();++ir) {
+		const StateRow& r=rows[ir];
+		if(!near(gridcell.get_lon(),r.lon) || !near(gridcell.get_lat(),r.lat)) continue;
+		for(int s=0;s<gridcell.nbr_stands();++s) {
+			Stand& stand=gridcell[s];
+			for(int p=0;p<stand.npatch();++p) {
+				Patch& patch=stand[p];
+				for(unsigned int i=0;i<patch.vegetation.size();++i) {
+					Individual& indiv=patch.vegetation[i];
+					if(indiv.pft.name!=r.pft) continue;
+					indiv.densindiv=r.densindiv;
+					indiv.height=r.height;
+					indiv.crownarea=r.crownarea;
+					indiv.cmass_leaf=r.cmass_leaf;
+					indiv.cmass_root=r.cmass_root;
+					indiv.cmass_sap=r.cmass_sap;
+					indiv.cmass_heart=r.cmass_heart;
+					indiv.cmass_debt=r.cmass_debt;
+					indiv.age=(int)r.age;
+				}
+			}
+		}
+	}
+}
+
+}
