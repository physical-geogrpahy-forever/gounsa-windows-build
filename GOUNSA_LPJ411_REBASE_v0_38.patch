@@ -0,0 +1,184 @@
+#include "stdafx.h"
+#include "gounsa_exchange_output.h"
+#include "guess.h"
+#include "outputmodule.h"
+
+#include <fstream>
+#include <iomanip>
+
+namespace {
+std::ofstream out;
+bool header=false;
+}
+
+namespace gounsa_exchange_output {
+
+void daily(const Gridcell& gridcell) {
+	if(!out.is_open()) out.open("veslem_exchange.out",std::ios::out);
+	if(!header) {
+		out << "Lon Lat Year Day LeafC FineRootC SurfaceLitC SurfRunoff\n";
+		header=true;
+	}
+	double leaf=0,root=0,lit=0;
+	for(int s=0;s<gridcell.nbr_stands();++s) {
+		const Stand& stand=gridcell[s];
+		for(int p=0;p<stand.npatch();++p) {
+			const Patch& patch=stand[p];
+			for(unsigned int i=0;i<patch.vegetation.size();++i) {
+				const Individual& indiv=patch.vegetation[i];
+				leaf += indiv.cmass_leaf;
+				root += indiv.cmass_root;
+			}
+			lit += patch.litter.ag_fast + patch.litter.ag_slow;
+		}
+	}
+	double runoff=gridcell.runoff.surfrunoff;
+	out << std::setprecision(10) << gridcell.get_lon() << ' ' << gridcell.get_lat() << ' '
+	    << date.get_calendar_year() << ' ' << date.day + 1 << ' '
+	    << leaf << ' ' << root << ' ' << lit << ' ' << runoff << '\n';
+}
+
+}
